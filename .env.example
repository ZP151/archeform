# Local infrastructure
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory_pilot?schema=public
REDIS_URL=redis://localhost:6379
FACTORY_POSTGRES_PORT=5432
FACTORY_REDIS_PORT=6379
FACTORY_CONTROL_PLANE_PORT=3000
FACTORY_WORKBENCH_PORT=5174
# Optional browser-visible override for a reverse proxy or non-local endpoint.
# By default Compose derives the endpoint from FACTORY_CONTROL_PLANE_PORT.
FACTORY_PUBLIC_CONTROL_PLANE_URL=

# Optional guarded real-model acceptance only. Do not commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional read-only GitHub API token for fixed-reference source acquisition.
# It is read only from the local process environment and is never persisted.
FACTORY_GITHUB_READ_TOKEN=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-trust-policy/v1",
  "title": "Factory Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "policy_digest", "issued_at", "spdx_license_list_version", "allowed_spdx_expressions", "prohibited_spdx_identifiers", "exceptions", "authorized_signers", "max_evidence_age_seconds", "required_evidence"],
  "properties": {
    "schema_version": {"const": "factory-trust-policy/v1"},
    "policy_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "spdx_license_list_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "allowed_spdx_expressions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/spdx_expression"}},
    "prohibited_spdx_identifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$"}},
    "exceptions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exception"}},
    "authorized_signers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/signer"}},
    "max_evidence_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "required_evidence": {"type": "array", "uniqueItems": true, "items": {"enum": ["spdx-3.0-json", "in-toto-statement-v1/slsa-v1.1", "dsse-v1"]}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "spdx_expression": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9.+() -]+$"},
    "exception": {"type": "object", "additionalProperties": false, "required": ["id", "expires_at"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}, "expires_at": {"$ref": "#/$defs/timestamp"}}},
    "signer": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "public_key"], "properties": {"fingerprint": {"$ref": "#/$defs/digest"}, "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 43, "maxLength": 44}}}
  }
}

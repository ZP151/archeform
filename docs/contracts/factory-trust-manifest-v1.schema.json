{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "factory-trust-manifest/v1", "title": "Factory Trust Manifest v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "records"], "properties": {"schema_version": {"const": "factory-trust-manifest/v1"}, "records": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["key", "version", "package_digest", "record_digest", "policy_digest", "evidence_digests"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "package_digest": {"$ref": "#/$defs/digest"}, "record_digest": {"$ref": "#/$defs/digest"}, "policy_digest": {"$ref": "#/$defs/digest"}, "evidence_digests": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}}}}},
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}

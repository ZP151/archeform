{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-trust-record/v1",
  "title": "Factory Trust Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_digest", "issued_at", "subject", "source", "license", "sbom", "provenance", "signature", "verification"],
  "properties": {
    "schema_version": {"const": "factory-trust-record/v1"}, "record_digest": {"$ref": "#/$defs/digest"}, "issued_at": {"$ref": "#/$defs/timestamp"},
    "subject": {"$ref": "#/$defs/subject"},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "revision"], "properties": {"repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["expression", "license_list_version", "policy_version", "dependency_result", "exceptions"], "properties": {"expression": {"type": "string", "pattern": "^[A-Za-z0-9.+() -]+$"}, "license_list_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}, "policy_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "dependency_result": {"enum": ["passed"]}, "exceptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}}}},
    "sbom": {"$ref": "#/$defs/evidence_ref"}, "provenance": {"$ref": "#/$defs/evidence_ref"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["type", "digest", "record_payload_digest", "key_fingerprint"], "properties": {"type": {"const": "dsse-v1"}, "digest": {"$ref": "#/$defs/digest"}, "record_payload_digest": {"$ref": "#/$defs/digest"}, "key_fingerprint": {"$ref": "#/$defs/digest"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "policy_digest", "verified_at", "verdict"], "properties": {"status": {"const": "verified"}, "policy_digest": {"$ref": "#/$defs/digest"}, "verified_at": {"$ref": "#/$defs/timestamp"}, "verdict": {"const": "allow"}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["key", "version", "digest"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["type", "digest"], "properties": {"type": {"enum": ["spdx-3.0-json", "in-toto-statement-v1/slsa-v1.1"]}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}

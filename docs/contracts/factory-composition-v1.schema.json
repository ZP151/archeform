{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-composition/v1",
  "title": "Factory Composition Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_definition_checksum",
    "component_locks",
    "validated_inputs",
    "dependency_graph",
    "adapter_order",
    "output_manifest"
  ],
  "properties": {
    "schema_version": {"const": "factory-composition/v1"},
    "application_definition_checksum": {"$ref": "#/$defs/digest"},
    "component_locks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lock"}},
    "validated_inputs": {"type": "object"},
    "dependency_graph": {"type": "array", "items": {"$ref": "#/$defs/dependency_edge"}},
    "adapter_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lock"}},
    "output_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {"files": {"type": "array", "items": {"$ref": "#/$defs/output_file"}}}
    }
  },
  "$defs": {
    "component_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "digest"],
      "properties": {"key": {"$ref": "#/$defs/component_key"}, "version": {"$ref": "#/$defs/semver"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "dependency_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/component_key"}, "to": {"$ref": "#/$defs/component_key"}}
    },
    "output_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/digest"}}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory-pilot.local/contracts/application-definition-v1.schema.json",
  "title": "Factory Pilot Application Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "profile", "roles", "primary_record", "workflow", "pages", "non_functional", "assumptions", "open_questions"],
  "properties": {
    "apiVersion": {"const": "factory/v1"},
    "kind": {"const": "ApplicationDefinition"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "profile": {"const": "internal-approval-app"},
    "roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/role"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "submitter"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "approver"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "auditor"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 3},
        {"contains": {"properties": {"kind": {"const": "observer"}}, "required": ["kind"]}, "minContains": 0, "maxContains": 3}
      ]
    },
    "primary_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "fields"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "states", "transitions"],
      "properties": {
        "id": {"const": "approval"},
        "states": {"const": ["draft", "submitted", "approved", "rejected"]},
        "transitions": {
          "const": [
            {"from": "draft", "to": "submitted", "action": "submit", "actor_kind": "submitter"},
            {"from": "submitted", "to": "approved", "action": "approve", "actor_kind": "approver"},
            {"from": "submitted", "to": "rejected", "action": "reject", "actor_kind": "approver"}
          ]
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/page"},
      "allOf": [
        {"contains": {"properties": {"id": {"const": "submit"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "my_records"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "approval_queue"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "audit"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "non_functional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_log", "persistence", "ui"],
      "properties": {
        "audit_log": {"const": true},
        "persistence": {"const": "postgresql"},
        "ui": {"const": "responsive_web"}
      }
    },
    "assumptions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/statement"}},
    "open_questions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/statement"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^<>\\r\\n]+$"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^<>\\r\\n]+$"},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "kind": {"enum": ["submitter", "approver", "auditor", "observer"]}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "type": {"enum": ["string", "number", "date", "enum"]},
        "required": {"type": "boolean"},
        "options": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/label"}}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["options"]}, "else": {"not": {"required": ["options"]}}}
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "actor_kinds"],
      "properties": {
        "id": {"enum": ["submit", "my_records", "approval_queue", "audit"]},
        "label": {"$ref": "#/$defs/label"},
        "kind": {"enum": ["form", "list", "queue", "audit"]},
        "actor_kinds": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["submitter", "approver", "auditor", "observer"]}}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "submit"}}}, "then": {"properties": {"kind": {"const": "form"}}}},
        {"if": {"properties": {"id": {"const": "my_records"}}}, "then": {"properties": {"kind": {"const": "list"}}}},
        {"if": {"properties": {"id": {"const": "approval_queue"}}}, "then": {"properties": {"kind": {"const": "queue"}}}},
        {"if": {"properties": {"id": {"const": "audit"}}}, "then": {"properties": {"kind": {"const": "audit"}}}}
      ]
    }
  }
}

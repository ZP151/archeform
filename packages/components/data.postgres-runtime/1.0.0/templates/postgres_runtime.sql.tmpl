REVOKE ALL ON DATABASE approval_app FROM PUBLIC;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;

DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'approval_runtime') THEN
        CREATE ROLE approval_runtime LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;
    END IF;
END;
$$;

GRANT CONNECT ON DATABASE approval_app TO approval_runtime;
